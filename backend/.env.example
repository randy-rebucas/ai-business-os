# Copy to backend/.env for local overrides. Never commit real secrets. Every setting: abos/core/config.py
ABOS_ENV=development
ABOS_DATABASE_URL=postgresql+psycopg://abos:abos_dev_password@127.0.0.1:55470/abos
# The API SET ROLEs into this non-owner role so Postgres row-level security applies (ADR-003).
ABOS_DB_APP_ROLE=abos_app
ABOS_REDIS_URL=redis://127.0.0.1:56470/0
ABOS_APP_BASE_URL=http://localhost:3470

# Sessions. Production: ABOS_COOKIE_SECURE=true and ABOS_SESSION_COOKIE_NAME=__Host-abos_session
ABOS_COOKIE_SECURE=false
ABOS_SESSION_COOKIE_NAME=abos_session

# Mail: dev_outbox stores messages in the email_outbox table (never sends). smtp delivers.
ABOS_MAILER=dev_outbox
# ABOS_SMTP_HOST=
# ABOS_SMTP_PORT=587
# ABOS_SMTP_USERNAME=
# ABOS_SMTP_PASSWORD=

# Object storage (ADR-011). local = files under ABOS_STORAGE_DIR (dev only); s3 needs `pip install boto3`.
ABOS_STORAGE_BACKEND=local
ABOS_STORAGE_DIR=storage
# ABOS_S3_BUCKET=
# ABOS_S3_ENDPOINT_URL=
# ABOS_S3_REGION=
ABOS_UPLOAD_MAX_BYTES=20971520

# Background jobs (ADR-008). false = a Celery worker must run: celery -A abos.jobs.worker worker --pool=solo
ABOS_JOBS_EAGER=false

# AI layer (ADR-012). dev / hash are labelled development adapters (no model calls); refused in production.
ABOS_LLM_PROVIDER=dev
# ABOS_ANTHROPIC_API_KEY=
ABOS_LLM_MODEL=claude-opus-5-5
ABOS_LLM_EFFORT=medium
ABOS_EMBEDDING_PROVIDER=hash
# ABOS_EMBEDDING_MODEL=voyage-3.5
# ABOS_EMBEDDING_API_KEY=
# ABOS_EMBEDDING_BASE_URL=        # openai-compatible endpoint
ABOS_RETRIEVAL_MIN_VECTOR_SCORE=0.25

ABOS_SEED_PASSWORD=dev-password-change-me
ABOS_LOG_LEVEL=INFO

# Notifications (Phase 6). SMS: dev stores messages (labelled, refused in production) · none disables SMS.
ABOS_SMS_PROVIDER=dev
# ABOS_NOTIFY_EMAIL_PER_HOUR=20
# ABOS_NOTIFY_SMS_PER_DAY=10
# ABOS_NOTIFY_MAX_ATTEMPTS=5

# Rate limits "<count>/<seconds>" (Phase 7). ai_work = generation, simulations, runs, reports, ingestion, extraction.
# ABOS_RL_AI_WORK_USER=60/3600
# ABOS_RL_AI_WORK_ORG=300/3600
# ABOS_RL_EXPORT_USER=5/86400

# Data retention & deletion (Phase 7, docs/OPERATIONS.md). Housekeeping (worker/beat only) connects as the table
# owner; give this URL to the worker and beat, never to the API. Empty = ABOS_DATABASE_URL (dev).
# ABOS_MAINTENANCE_DATABASE_URL=postgresql+psycopg://abos_owner:...@db:5432/abos
# ABOS_ORG_DELETION_GRACE_HOURS=72
# ABOS_EXPORT_TTL_HOURS=72
# ABOS_JOB_RUNS_RETENTION_DAYS=90
# ABOS_SESSIONS_RETENTION_DAYS=30
# ABOS_AUTH_EVENTS_RETENTION_DAYS=365
# ABOS_OUTBOX_RETENTION_DAYS=90

# Observability (Phase 7). GET /api/metrics needs "Authorization: Bearer <token>"; unset = endpoint off.
# ABOS_METRICS_TOKEN=
# ABOS_ERROR_REPORTER=log          # or sentry (pip install sentry-sdk; not verified against a live project)
# ABOS_SENTRY_DSN=
